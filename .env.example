# --- Telegram (recommended) -------------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Send any message to your new bot.
# 3. Run: python run.py telegram-discover
# 4. Paste the returned chat id below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Public URL of the dashboard, used in the Telegram digest header.
# For reading on your phone on the same Wi-Fi use e.g. http://192.168.1.5:8765
PUBLIC_BASE_URL=

# --- App --------------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
TZ=Asia/Kolkata
